    (* <- lang_ru;; *);;

askai_q_external_language
=> nrel_main_idtf: [Что такое внешний язык?] (* <- lang_ru;; *);
=> nrel_main_idtf: [что такое внешний язык?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is external language?] (* <- lang_en;; *);
=> nrel_answer:
    [Внешний язык — это язык пользовательского представления и ввода/вывода, который используется для взаимодействия с ostis-системой поверх внутреннего SC-представления знаний.]
    (* <- lang_ru;; *);;

