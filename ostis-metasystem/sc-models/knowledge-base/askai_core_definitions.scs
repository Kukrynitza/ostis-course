    (* <- lang_ru;; *);;

askai_q_decomposition
=> nrel_main_idtf: [Что такое декомпозиция?] (* <- lang_ru;; *);
=> nrel_main_idtf: [что такое декомпозиция?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is decomposition?] (* <- lang_en;; *);
=> nrel_answer:
    [Декомпозиция — это разбиение сложной системы или задачи на более простые составные части (подсистемы), которые можно рассматривать и анализировать отдельно.]
    (* <- lang_ru;; *);;

askai_q_ims
=> nrel_main_idtf: [Что такое IMS?] (* <- lang_ru;; *);
=> nrel_main_idtf: [что такое ims?] (* <- lang_ru;; *);
=> nrel_main_idtf: [Что такое ИМС?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is IMS?] (* <- lang_en;; *);
=> nrel_answer:
    [IMS (Intelligent Management System) — интеллектуальная система управления, построенная на технологии OSTIS и использующая семантическое представление знаний.]
    (* <- lang_ru;; *);;

askai_q_ostis
=> nrel_main_idtf: [Что такое OSTIS?] (* <- lang_ru;; *);
=> nrel_main_idtf: [что такое ostis?] (* <- lang_ru;; *);
=> nrel_main_idtf: [Что такое ОСТИС?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is OSTIS?] (* <- lang_en;; *);
=> nrel_answer:
    [OSTIS (Open Semantic Technology for Intelligent Systems) — технология проектирования интеллектуальных систем с открытой семантикой и единым форматом представления знаний.]
    (* <- lang_ru;; *);;

askai_q_system
=> nrel_main_idtf: [Что такое система?] (* <- lang_ru;; *);
=> nrel_main_idtf: [что такое система?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is system?] (* <- lang_en;; *);
=> nrel_answer:
    [Система — это целостная совокупность взаимосвязанных элементов, которые совместно выполняют функции и образуют единое целое.]
    (* <- lang_ru;; *);;

askai_q_discrete_math
=> nrel_main_idtf: [Что такое дискретная математика?] (* <- lang_ru;; *);
=> nrel_main_idtf: [Что такое дикретная математика?] (* <- lang_ru;; *);
=> nrel_main_idtf: [what is discrete mathematics?] (* <- lang_en;; *);
=> nrel_answer:
    [Дискретная математика — раздел математики, изучающий дискретные структуры: множества, графы, отношения, логические и комбинаторные объекты.]
    (* <- lang_ru;; *);;

askai_q_graph
=> nrel_main_idtf: [Что такое граф?] (* <- lang_ru;; *);
=> nrel_main_idtf: [что такое граф?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is graph?] (* <- lang_en;; *);
=> nrel_answer:
    [Граф — это математическая структура, состоящая из вершин (узлов) и рёбер (связей), которые задают отношения между объектами.]
    (* <- lang_ru;; *);;

