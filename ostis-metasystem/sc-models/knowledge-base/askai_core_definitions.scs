=> nrel_main_idtf: [Что такое семантическая окрестность sc-элемента?] (* <- lang_ru;; *);
=> nrel_main_idtf: [What is semantic neighborhood?] (* <- lang_en;; *);
=> nrel_answer:
    [Семантическая окрестность sc-элемента — совокупность связанных с ним sc-элементов и отношений, достаточная для восстановления его смысла в заданном контексте.]
    (* <- lang_ru;; *);;

